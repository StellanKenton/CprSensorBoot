{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.associations": {
    "*.ld": "ld"
  },
  "cpr.tools.armGdbPath": "arm-none-eabi-gdb.exe",
  "cpr.tools.jlinkGdbServer": "JLinkGDBServerCL.exe",
  "cpr.target.device": "STM32F103RE",
  "cpr.target.interface": "swd",
  "cpr.target.speed": "4000",
  "cpr.target.gdbPort": "3331",
  "cpr.target.swoPort": "3332",
  "cpr.target.telnetPort": "3333",
  "cpr.target.rttTelnetPort": "19021",
  "commands.workspaceCommands": {
    "CprSensorBoot Build": {
      "command": "workbench.action.tasks.runTask",
      "args": "Keil: Build",
      "icon": "tools",
      "statusBar": {
        "alignment": "left",
        "text": " Build",
        "name": "CprSensorBoot Build",
        "priority": 400,
        "tooltip": "Run the Keil build task in the integrated terminal."
      }
    },
    "CprSensorBoot Flash": {
      "command": "workbench.action.tasks.runTask",
      "args": "J-Link: Flash",
      "icon": "plug",
      "statusBar": {
        "alignment": "left",
        "text": " Flash",
        "name": "CprSensorBoot Flash",
        "priority": 399,
        "tooltip": "Build and flash the target with the J-Link task."
      }
    },
    "CprSensorBoot RTT IO": {
      "icon": "terminal",
      "sequence": [
        {
          "command": "workbench.action.tasks.runTask",
          "args": "J-Link: RTT Server"
        },
        {
          "command": "workbench.action.tasks.runTask",
          "args": "J-Link: RTT Terminal",
          "delay": 800
        }
      ],
      "statusBar": {
        "alignment": "left",
        "text": " RTT",
        "name": "CprSensorBoot RTT IO",
        "priority": 398,
        "tooltip": "Start the J-Link RTT server, then open the RTT terminal for read and write I/O."
      }
    },
    "CprSensorBoot Rebuild": {
      "command": "workbench.action.tasks.runTask",
      "args": "Keil: Rebuild",
      "icon": "refresh",
      "statusBar": {
        "alignment": "left",
        "text": " Rebuild",
        "name": "CprSensorBoot Rebuild",
        "priority": 397,
        "tooltip": "Run the Keil rebuild task in the integrated terminal."
      }
    },
    "CprSensorBoot Reset": {
      "command": "workbench.action.tasks.runTask",
      "args": "J-Link: Reset",
      "icon": "debug-restart",
      "statusBar": {
        "alignment": "left",
        "text": " Reset",
        "name": "CprSensorBoot Reset",
        "priority": 396,
        "tooltip": "Reset the target with J-Link."
      }
    },
    "CprSensorBoot Serial Monitor": {
      "command": "workbench.action.tasks.runTask",
      "args": "Serial: Monitor",
      "icon": "device-mobile",
      "statusBar": {
        "alignment": "left",
        "text": " Serial",
        "name": "CprSensorBoot Serial Monitor",
        "priority": 395,
        "tooltip": "Open the UART serial monitor. If needed, VS Code will prompt for the COM port."
      }
    },
    "CprSensorBoot Debug": {
      "command": "workbench.action.debug.start",
      "icon": "debug",
      "statusBar": {
        "alignment": "left",
        "text": " Debug",
        "name": "CprSensorBoot Debug",
        "priority": 394,
        "tooltip": "Start the Cortex-Debug J-Link session."
      }
    }
  },
  "actionButtons": {
    "reloadButton": null,
    "defaultColor": "none",
    "loadNpmCommands": false,
    "commands": [
      {
        "name": "$(tools) Build",
        "tooltip": "Run the Keil build task in the integrated terminal.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "Keil: Build"
        ]
      },
      {
        "name": "$(refresh) Rebuild",
        "tooltip": "Run the Keil rebuild task in the integrated terminal.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "Keil: Rebuild"
        ]
      },
      {
        "name": "$(debug) Debug",
        "tooltip": "Start the Cortex-Debug J-Link session.",
        "useVsCodeApi": true,
        "command": "workbench.action.debug.start"
      },
      {
        "name": "$(plug) Flash",
        "tooltip": "Build and flash the target with the J-Link task.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "J-Link: Flash"
        ]
      },
      {
        "name": "$(debug-restart) Reset",
        "tooltip": "Reset the target with J-Link.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "J-Link: Reset"
        ]
      },
      {
        "name": "$(terminal) RTT",
        "tooltip": "Start the J-Link RTT server, then open the RTT terminal for read and write I/O.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "J-Link: RTT Open"
        ]
      },
      {
        "name": "$(device-mobile) Serial",
        "tooltip": "Open the UART serial monitor. If needed, VS Code will prompt for the COM port.",
        "useVsCodeApi": true,
        "command": "workbench.action.tasks.runTask",
        "args": [
          "Serial: Monitor"
        ]
      }
    ]
  }
}
